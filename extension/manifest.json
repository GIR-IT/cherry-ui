{
  "manifest_version": 3,
  "name": "Cherry for GitHub",
  "short_name": "Cherry",
  "version": "1.0.0",
  "description": "Open any GitHub repository, branch, compare view or pull request in cherry-ui.com to cherry-pick its commits.",
  "homepage_url": "https://cherry-ui.com",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open in Cherry",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": ["activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "open-in-cherry": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Open the current GitHub page in Cherry"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["cherry-url.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
